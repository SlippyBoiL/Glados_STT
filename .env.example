# Copy to .env and fill in your keys (never commit .env)

# --- Hermes Agent local llama.cpp (primary brain + native function calling) ---
LLM_PROVIDER=hermes
HERMES_BASE_URL=http://127.0.0.1:18434/v1
HERMES_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M
# API key is read from %LOCALAPPDATA%\hermes\runtimes\llamacpp\server.json
# HERMES_API_KEY=

# --- NVIDIA NIM (unused while LLM_PROVIDER=hermes) ---
# NVIDIA_API_KEY_1=nvapi-YOUR_KEY_1
# NVIDIA_API_KEY_2=nvapi-YOUR_KEY_2
# NVIDIA_API_KEY_3=nvapi-YOUR_KEY_3
# NVIDIA_API_KEY_4=nvapi-YOUR_KEY_4
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NVIDIA_PREFER_HERMES=0
HERMES_OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b
# Per-key models (optional overrides)
NVIDIA_MODEL_1=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_2=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_3=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Local deepseek-moe failover (Master Node llama-server)
LOCAL_FAILOVER_BASE_URL=http://192.168.0.102:5000/v1
LOCAL_FAILOVER_MODEL=deepseek-moe

# --- Honcho (self-hosted memory — scripts/start_honcho.ps1) ---
HONCHO_URL=http://127.0.0.1:8000
# HONCHO_API_KEY=  # only for api.honcho.dev managed
MEMORY_ENABLE_HONCHO=1

# Legacy (optional)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Phone alerts (ntfy free push; Twilio optional) ---
PHONE_ALERT_PROVIDER=inkbox
# Inkbox credentials are read from Hermes (%LOCALAPPDATA%/hermes/.env).
# INKBOX_API_KEY=
INKBOX_IDENTITY=gladosai
# Public HTTPS origin for live-call PC control (GLaDOS websocket), if not using Inkbox tunnel:
# INKBOX_PUBLIC_URL=https://your-public-host.example
# GLADOS_CALL_WS_URL=wss://your-public-host.example/api/phone/inkbox
# Optional override destination (defaults to TWILIO_TO_NUMBER).
# INKBOX_TO_NUMBER=
INKBOX_AUTO_PROVISION=0

# --- Telegram (GLaDOS inbox; token can live in Hermes %LOCALAPPDATA%/hermes/.env) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
TELEGRAM_INBOX_ENABLED=1
INKBOX_TASK_INBOX_ENABLED=1

# --- ntfy push + inbound commands ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Publish to NTFY_TOPIC from the ntfy app to command GLaDOS (e.g. "call me")
NTFY_INBOX_ENABLED=1

# --- Free backup: ntfy push (optional) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Optional: public URL for /call when phone is off home Wi-Fi (free Cloudflare Tunnel)
GLADOS_CALL_URL=

# --- Twilio PSTN (optional, paid) — real cellular voice calls ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=+16896102968
TWILIO_PUBLIC_WS_URL=wss://your-tunnel.example/media
PHONE_SERVER_HOST=0.0.0.0
PHONE_SERVER_PORT=5050

# --- SSH targets ---
# Proxmox VE @ 192.168.0.129 (SSH :22, web :8080)
SSH_PASSWORD_PROXMOX=

# --- Emergency / alerts ---
ALERT_SPEAKER_DEVICE=Z906
GOVEE_API_KEY=

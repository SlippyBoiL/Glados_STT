{
  "version": 1,
  "description": "GLaDOS Capability Registry — hardcoded allowlist for OS execution safety",
  "confidence_levels": {
    "CERTAIN": {
      "min_score": 0.85,
      "auto_execute_if_allowed": true
    },
    "PROBABLE": {
      "min_score": 0.55,
      "auto_execute_if_allowed": false,
      "requires_confirmation": true
    },
    "UNKNOWN": {
      "min_score": 0.0,
      "auto_execute_if_allowed": false,
      "requires_confirmation": true,
      "dry_run_required": true
    }
  },
  "allowed_auto_execute": [
    "Get-Process",
    "Get-Service",
    "Get-ChildItem",
    "Get-Content",
    "Get-Item",
    "Get-Location",
    "Get-Date",
    "Get-ComputerInfo",
    "Get-NetIPAddress",
    "Get-NetAdapter",
    "Get-Disk",
    "Get-Volume",
    "Get-PSDrive",
    "Test-Path",
    "Test-Connection",
    "Resolve-Path",
    "Select-Object",
    "Where-Object",
    "Sort-Object",
    "Measure-Object",
    "Format-Table",
    "Format-List",
    "Write-Output",
    "Write-Host",
    "echo",
    "dir",
    "ls",
    "pwd",
    "whoami",
    "hostname",
    "ipconfig",
    "systeminfo",
    "tasklist",
    "docker ps",
    "docker stats",
    "docker logs",
    "git status",
    "git log",
    "git diff",
    "git branch",
    "git remote",
    "Start-Process",
    "Stop-Process"
  ],
  "requires_confirmation": [
    "Restart-Computer",
    "Stop-Computer",
    "Restart-Service",
    "Stop-Service",
    "Start-Service",
    "Remove-Item",
    "Move-Item",
    "Copy-Item",
    "New-Item",
    "Set-Content",
    "Add-Content",
    "Out-File",
    "Set-ExecutionPolicy",
    "Install-Package",
    "Uninstall-Package",
    "winget install",
    "winget uninstall",
    "choco install",
    "choco uninstall",
    "pip install",
    "pip uninstall",
    "npm install",
    "npm uninstall",
    "docker stop",
    "docker rm",
    "docker restart",
    "docker kill",
    "git push",
    "git commit",
    "git reset",
    "git checkout",
    "git merge",
    "git rebase",
    "git clean",
    "schtasks",
    "reg add",
    "reg delete",
    "netsh",
    "shutdown"
  ],
  "blocked_operations": [
    "Format-Volume",
    "Clear-Disk",
    "Initialize-Disk",
    "Remove-Partition",
    "diskpart",
    "cipher /w",
    "bcdedit",
    "bootrec",
    "Remove-Computer",
    "Reset-ComputerMachinePassword",
    "Disable-ComputerRestore",
    "Disable-WindowsOptionalFeature",
    "Uninstall-WindowsFeature",
    "Remove-WindowsCapability",
    "Disable-LocalUser",
    "Remove-LocalUser",
    "Remove-LocalGroupMember",
    "net user .* /delete",
    "net localgroup administrators .* /delete",
    "rm -rf /",
    "rm -rf /*",
    "del /s /q C:\\Windows",
    "rd /s /q C:\\Windows",
    "Remove-Item -Recurse -Force C:\\Windows",
    "Remove-Item -Recurse -Force C:\\Users",
    "format c:",
    "format d:",
    "mkfs",
    "dd if=",
    "reg delete HKLM\\SYSTEM",
    "reg delete HKLM\\SOFTWARE\\Microsoft\\Windows",
    "shutdown /s /f",
    "shutdown /r /f /t 0",
    "Stop-Computer -Force",
    "curl * | iex",
    "iwr * | iex",
    "Invoke-Expression (Invoke-WebRequest",
    "DownloadString",
    "FromBase64String.*IEX",
    "Set-MpPreference -DisableRealtimeMonitoring",
    "sc stop WinDefend",
    "sc delete",
    "takeown /f C:\\Windows",
    "icacls C:\\Windows /grant"
  ],
  "dry_run": {
    "enabled": true,
    "powershell_whatif_preferred": true,
    "simulate_prefix": "[DRY-RUN]",
    "require_before_confirmation": true
  },
  "os_preservation": {
    "protect_system_paths": [
      "C:\\Windows",
      "C:\\Windows\\System32",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\Boot",
      "C:\\Recovery"
    ],
    "protect_boot_firmware": true,
    "protect_defender": true,
    "protect_user_profiles_bulk_delete": true
  }
}

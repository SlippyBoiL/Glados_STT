# Honcho deriver / dialectic — copy to honcho/.env (scripts/start_honcho.ps1 does this).
# Never commit the filled file.

AUTH_USE_AUTH=false
LOG_LEVEL=INFO
VECTOR_STORE_TYPE=pgvector
EMBED_MESSAGES=false

# Local Hermes llama.cpp (same server as GLaDOS chat). Key from Hermes server.json.
LLM_OPENAI_API_KEY=replace-from-hermes-server-json
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:18434/v1
DERIVER_FLUSH_ENABLED=true

DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:18434/v1

SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:18434/v1
